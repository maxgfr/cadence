# Content-Security-Policy of the built app (index.html %VITE_CSP%). Any https host in connect-src: the AI
# provider is the user's choice. Loopback http is allowed for local AI servers (Ollama, LM Studio).
VITE_CSP="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
